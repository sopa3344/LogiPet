<Window x:Class="LogiPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LogiPet - 맥스" Width="252" Height="230"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Aliased"
        RenderOptions.BitmapScalingMode="NearestNeighbor"
        Loaded="Window_Loaded" Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Grid Margin="5" Background="#01000000">
    <Border x:Name="MainWindowFrame" Style="{StaticResource XpWindowFrame}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="28"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <!-- XP.css title-bar structure, implemented with native WPF. -->
        <Border Grid.Row="0" Margin="0" Background="{StaticResource XpTitleGradient}"
                CornerRadius="4,4,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
          <Grid Margin="4,2,3,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="18"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Original XP-sized pixel dog app icon. -->
            <Canvas Width="16" Height="16" VerticalAlignment="Center" SnapsToDevicePixels="True">
              <Rectangle Fill="#252525" Width="10" Height="7" Canvas.Left="3" Canvas.Top="6"/>
              <Rectangle Fill="#C98235" Width="9" Height="6" Canvas.Left="3" Canvas.Top="5"/>
              <Rectangle Fill="#D99A4E" Width="5" Height="5" Canvas.Left="9" Canvas.Top="3"/>
              <Rectangle Fill="#9A5B27" Width="2" Height="4" Canvas.Left="9" Canvas.Top="3"/>
              <Rectangle Fill="#252525" Width="1" Height="1" Canvas.Left="13" Canvas.Top="5"/>
              <Rectangle Fill="#2DD48F" Width="5" Height="1" Canvas.Left="9" Canvas.Top="8"/>
              <Rectangle Fill="#C98235" Width="2" Height="3" Canvas.Left="2" Canvas.Top="4"/>
              <Rectangle Fill="#9A5B27" Width="2" Height="2" Canvas.Left="1" Canvas.Top="3"/>
              <Rectangle Fill="#9A5B27" Width="2" Height="3" Canvas.Left="4" Canvas.Top="11"/>
              <Rectangle Fill="#9A5B27" Width="2" Height="3" Canvas.Left="10" Canvas.Top="11"/>
            </Canvas>
            <TextBlock x:Name="AppTitleText" Grid.Column="1" Text="LogiPet - 맥스" FontFamily="{StaticResource GalmuriFont}"
                       FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"
                       TextOptions.TextRenderingMode="Aliased"/>
            <Button Grid.Column="2" Style="{StaticResource XpTitleButton}" Content="×"
                    ToolTip="닫기" Click="Exit_Click"/>
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="7,3,7,2">
          <Grid.RowDefinitions>
            <RowDefinition Height="59"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <GroupBox Grid.Row="0" Header="MX Master 4" Style="{StaticResource XpGroupBox}" Padding="7,8,7,5">
            <Grid x:Name="BatteryBubble">
              <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="19"/></Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="19"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="BatteryStateIcon" Source="Assets/Icons/battery.png" Width="16" Height="16" VerticalAlignment="Center"/>
                <ProgressBar x:Name="BubbleBatteryBar" Grid.Column="1" Style="{StaticResource XpProgressBar}"
                             Minimum="0" Maximum="100" Value="0" Margin="0,2,7,2"/>
                <TextBlock x:Name="BatteryText" Grid.Column="2" Text="--%" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource LogitechMint}" VerticalAlignment="Center"/>
              </Grid>
              <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource XpShadow}"
                      BorderThickness="1" Padding="4,1" SnapsToDevicePixels="True">
                <TextBlock x:Name="SpeechText" Text="배터리를 확인하는 중…"
                           FontFamily="{StaticResource NeoDunggeunmoFont}" FontSize="11"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </Border>
            </Grid>
          </GroupBox>

          <Grid Grid.Row="1" x:Name="CatMotion" Margin="0,0,0,0" RenderTransformOrigin="0.5,1">
            <Grid.RenderTransform>
              <TransformGroup>
                <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="PetMove"/>
              </TransformGroup>
            </Grid.RenderTransform>

            <Border x:Name="CatHitArea" Width="192" Height="66" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#01000000" Cursor="Hand" ClipToBounds="True"
                    MouseLeftButtonUp="Cat_MouseLeftButtonUp" MouseRightButtonUp="Cat_MouseRightButtonUp">
              <Grid>
                <Ellipse Width="82" Height="10" Fill="#35000000" HorizontalAlignment="Center"
                         VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                <Image x:Name="PetSprite" Width="200" Height="200"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Stretch="Fill" SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       RenderTransformOrigin="0.5,0.5">
                  <Image.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform x:Name="PetFacing" ScaleX="1" ScaleY="1"/>
                      <TranslateTransform x:Name="PetFrameOffset"/>
                    </TransformGroup>
                  </Image.RenderTransform>
                </Image>
              </Grid>
            </Border>

            <TextBlock x:Name="BoltEffect" Text="⚡" Visibility="Collapsed"
                       FontFamily="Segoe UI Symbol" FontSize="17" FontWeight="Bold"
                       Foreground="{StaticResource LogitechMint}" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,3,34,0" RenderTransformOrigin="0.5,0.5">
              <TextBlock.RenderTransform><TranslateTransform x:Name="BoltMove"/></TextBlock.RenderTransform>
            </TextBlock>
          </Grid>
        </Grid>

        <StatusBar Grid.Row="2" Style="{StaticResource XpStatusBar}">
          <Grid Width="224">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" ClipToBounds="True">
              <Border x:Name="ConnectionLed" Width="11" Height="11" Background="{StaticResource XpWarning}"
                      BorderBrush="#555" BorderThickness="1" Margin="2,0,5,0" VerticalAlignment="Center">
                <TextBlock Text="L" Foreground="#1E332A" FontFamily="{StaticResource GalmuriFont}"
                           FontSize="7" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="ConnectionText" Text="MX 확인 중" FontSize="10" VerticalAlignment="Center"/>
              <TextBlock Text=" · " FontSize="10" Foreground="#777" VerticalAlignment="Center"/>
              <TextBlock x:Name="ActivityModeText" Text="기다리는 중" FontSize="10"
                         Foreground="#245EDB" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Border Grid.Column="1" BorderBrush="#ACA899" BorderThickness="1,0,0,0" Padding="6,0,2,0"
                    ToolTip="{Binding Text, ElementName=ClockDateText}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ClockText" Text="오전 0:00" FontFamily="{StaticResource GalmuriFont}"
                           FontSize="9" Foreground="#222" VerticalAlignment="Center"/>
                <TextBlock x:Name="ClockDateText" Text="" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
          </Grid>
        </StatusBar>
      </Grid>
    </Border>

    <!-- A restrained XP assistant balloon: contextual, temporary, and anchored to Mochi. -->
    <Popup x:Name="SpeechBalloonPopup" PlacementTarget="{Binding ElementName=CatHitArea}"
           Placement="Top" VerticalOffset="-3" AllowsTransparency="True" StaysOpen="True">
      <StackPanel Width="218">
        <Border Background="#FFFFE1" BorderBrush="#101010" BorderThickness="1" Padding="9,6,7,7"
                SnapsToDevicePixels="True">
          <Border.Effect><DropShadowEffect BlurRadius="0" ShadowDepth="2" Direction="315" Color="#65000000"/></Border.Effect>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="BalloonNameText" Text="맥스" FontFamily="{StaticResource GalmuriFont}" FontSize="11"
                         FontWeight="Bold" Foreground="#003399"/>
              <Button Grid.Column="1" Content="×" Width="16" Height="16" Padding="0" Margin="5,-3,-2,0"
                      FontFamily="Tahoma" FontSize="11" Background="Transparent" BorderThickness="0"
                      Cursor="Hand" ToolTip="말풍선 닫기" Click="CloseSpeechBalloon_Click"/>
            </Grid>
            <TextBlock x:Name="BalloonText" Grid.Row="1" Margin="0,4,2,0" Text="안녕! 오늘도 옆에 있을게."
                       FontFamily="{StaticResource NeoDunggeunmoFont}" FontSize="11" LineHeight="16"
                       TextWrapping="Wrap" Foreground="#111" MaxWidth="196"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="-3,5,0,-2">
              <Button HorizontalAlignment="Left" Padding="3,1"
                      Background="Transparent" BorderThickness="0" Foreground="#0000EE" Cursor="Hand"
                      FontFamily="{StaticResource NeoDunggeunmoFont}" FontSize="10"
                      Content="오늘 활동 ▶" Click="BalloonActivity_Click"/>
              <TextBlock Text=" | " Foreground="#777" FontSize="10" VerticalAlignment="Center"/>
              <Button HorizontalAlignment="Left" Padding="3,1"
                      Background="Transparent" BorderThickness="0" Foreground="#0000EE" Cursor="Hand"
                      FontFamily="{StaticResource NeoDunggeunmoFont}" FontSize="10"
                      ToolTip="MX 사용자들의 활용법과 작업 환경을 둘러봅니다."
                      Content="MX 커뮤니티 ▶" Click="OpenCommunity_Click"/>
            </StackPanel>
          </Grid>
        </Border>
        <Grid Height="9" Width="218">
          <Polygon Points="96,0 116,0 106,9" Fill="#101010" HorizontalAlignment="Left"/>
          <Polygon Points="98,0 114,0 106,7" Fill="#FFFFE1" HorizontalAlignment="Left"/>
        </Grid>
      </StackPanel>
    </Popup>

    <!-- XP context menu shown from right click. -->
    <Popup x:Name="ActionMenuPopup" PlacementTarget="{Binding ElementName=CatHitArea}"
           Placement="Top" VerticalOffset="-2" AllowsTransparency="True" StaysOpen="False">
      <Border Background="White" BorderBrush="{StaticResource XpDark}" BorderThickness="1" Padding="2">
        <Border.Effect><DropShadowEffect BlurRadius="0" ShadowDepth="3" Direction="315" Color="#70000000"/></Border.Effect>
        <StackPanel>
          <Button Style="{StaticResource XpMenuButton}" Click="Talk_Click">
            <DockPanel><Image Source="Assets/Icons/info.png" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock x:Name="TalkMenuText" Text="맥스에게 말 걸기" VerticalAlignment="Center"/></DockPanel>
          </Button>
          <Border Height="1" Background="{StaticResource XpShadow}" Margin="3,2"/>
          <Button Style="{StaticResource XpMenuButton}" Click="Feed_Click">
            <DockPanel><Image Source="Assets/Icons/feed.png" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="간식으로 축하" VerticalAlignment="Center"/></DockPanel>
          </Button>
          <Button Style="{StaticResource XpMenuButton}" Click="Play_Click">
            <DockPanel><Image Source="Assets/Icons/play.png" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="하이파이브" VerticalAlignment="Center"/></DockPanel>
          </Button>
          <Button Style="{StaticResource XpMenuButton}" Click="Sleep_Click">
            <DockPanel><Image Source="Assets/Icons/sleep.png" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="같이 스트레칭" VerticalAlignment="Center"/></DockPanel>
          </Button>
          <Button Style="{StaticResource XpMenuButton}" Click="ShortPlay_Click">
            <DockPanel><Image Source="Assets/Icons/play.png" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="잠깐 놀기" VerticalAlignment="Center"/></DockPanel>
          </Button>
          <Border Height="1" Background="{StaticResource XpShadow}" Margin="3,2"/>
          <Button Style="{StaticResource XpMenuButton}" Click="Status_Click">
            <DockPanel><Image Source="Assets/Icons/info.png" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="오늘 활동" VerticalAlignment="Center"/></DockPanel>
          </Button>
          <Button Style="{StaticResource XpMenuButton}" Click="Rename_Click">
            <DockPanel><Image Source="Assets/Icons/settings.png" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="이름 바꾸기..." VerticalAlignment="Center"/></DockPanel>
          </Button>
          <Border Height="1" Background="{StaticResource XpShadow}" Margin="3,2"/>
          <Button Style="{StaticResource XpMenuButton}" Click="OpenCommunity_Click"
                  ToolTip="MX 사용자들의 실제 활용법과 팁을 확인합니다.">
            <DockPanel><Image Source="Assets/Icons/community.png" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="MX 커뮤니티 바로 가기" VerticalAlignment="Center"/></DockPanel>
          </Button>
        </StackPanel>
      </Border>
    </Popup>

    <Popup x:Name="NamePopup" PlacementTarget="{Binding ElementName=MainWindowFrame}"
           Placement="Top" VerticalOffset="-5" AllowsTransparency="True" StaysOpen="True">
      <Border Width="252" Style="{StaticResource XpWindowFrame}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="82"/><RowDefinition Height="33"/></Grid.RowDefinitions>
          <Border Background="{StaticResource XpTitleGradient}" CornerRadius="4,4,0,0">
            <Grid Margin="5,2,3,2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Image Source="Assets/Icons/settings.png" Width="16" Height="16" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="강아지 이름" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
              <Button Grid.Column="2" Style="{StaticResource XpTitleButton}" Content="×" Click="CancelName_Click"/>
            </Grid>
          </Border>
          <StackPanel Grid.Row="1" Margin="10,8,10,4">
            <TextBlock Text="MX의 친구를 뭐라고 부를까요? (최대 8글자)" FontSize="10" Margin="0,0,0,5"/>
            <TextBox x:Name="PetNameInput" MaxLength="8" Height="23" Padding="4,2" FontFamily="{StaticResource GalmuriFont}" FontSize="11"/>
            <TextBlock x:Name="PetNameValidationText" Text="이름을 한 글자 이상 입력해 주세요." Foreground="#C40000" FontSize="9" Margin="1,3,0,0" Visibility="Collapsed"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,8,6">
            <Button Style="{StaticResource XpButton}" Width="62" Height="22" Content="저장" Click="SaveName_Click"/>
            <Button Style="{StaticResource XpButton}" Width="62" Height="22" Margin="6,0,0,0" Content="취소" Click="CancelName_Click"/>
          </StackPanel>
        </Grid>
      </Border>
    </Popup>

    <Popup x:Name="StatusPopup" PlacementTarget="{Binding ElementName=MainWindowFrame}"
           Placement="Top" VerticalOffset="-5" AllowsTransparency="True" StaysOpen="True">
      <Border Width="278" Style="{StaticResource XpWindowFrame}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="194"/><RowDefinition Height="26"/></Grid.RowDefinitions>
          <Border Background="{StaticResource XpTitleGradient}" CornerRadius="4,4,0,0">
            <Grid Margin="5,2,3,2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Image Source="Assets/Icons/settings.png" Width="16" Height="16" VerticalAlignment="Center"/>
              <TextBlock x:Name="StatusTitleText" Grid.Column="1" Text="맥스 상태" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
              <Button Grid.Column="2" Style="{StaticResource XpTitleButton}" Content="×" Click="CloseStatus_Click"/>
            </Grid>
          </Border>

          <TabControl x:Name="StatusTabs" Grid.Row="1" Style="{StaticResource XpTabControl}" Margin="7,7,7,4">
            <TabItem Header="상태">
              <StackPanel>
                <GroupBox Header="MX Master 4" Style="{StaticResource XpGroupBox}" Margin="0,0,0,5">
                  <StackPanel>
                    <DockPanel>
                      <!-- Original pixel MX Master 4 silhouette. -->
                      <Canvas Width="18" Height="22" Margin="0,0,7,0" SnapsToDevicePixels="True">
                        <Rectangle Fill="#3C3C3C" Width="14" Height="20" Canvas.Left="2" Canvas.Top="1"/>
                        <Rectangle Fill="#ECE9D8" Width="1" Height="7" Canvas.Left="8" Canvas.Top="2"/>
                        <Rectangle Fill="#2DD48F" Width="3" Height="5" Canvas.Left="7" Canvas.Top="3"/>
                        <Rectangle Fill="#777" Width="4" Height="2" Canvas.Left="3" Canvas.Top="7"/>
                      </Canvas>
                      <StackPanel>
                        <TextBlock x:Name="BatteryDetail" Text="배터리를 확인하는 중…" FontSize="10"/>
                        <TextBlock x:Name="ConnectionDetail" Text="연결 확인 중" FontSize="10" Foreground="#555"/>
                      </StackPanel>
                    </DockPanel>
                    <ProgressBar x:Name="BatteryBar" Style="{StaticResource XpProgressBar}"
                                 Minimum="0" Maximum="100" Value="0" Margin="0,6,0,0"/>
                  </StackPanel>
                </GroupBox>

                <GroupBox x:Name="CurrentPetGroup" Header="지금 맥스" Style="{StaticResource XpGroupBox}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="동행 상태" FontSize="10"/>
                      <TextBlock x:Name="CurrentActivityText" Text="기다리는 중" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="이번 동행" FontSize="10"/>
                      <TextBlock x:Name="CurrentSessionText" Text="0분" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                  </Grid>
                </GroupBox>
              </StackPanel>
            </TabItem>
            <TabItem Header="정보">
              <StackPanel>
                <DockPanel Margin="0,0,0,8">
                  <Image Source="Assets/Icons/info.png" Width="16" Height="16" Margin="0,0,7,0"/>
                  <TextBlock Text="LogiPet 1.1" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="MX Master 4로 일하는 동안 함께 걷고 쉬며 활동을 기록하는 작은 픽셀 동반견입니다."
                           TextWrapping="Wrap" LineHeight="17"/>
              </StackPanel>
            </TabItem>
            <TabItem x:Name="ActivityTab" Header="오늘 활동">
              <StackPanel>
                <DockPanel Margin="0,0,0,5">
                  <TextBlock x:Name="ActivityDateText" Text="오늘" FontWeight="Bold"/>
                  <TextBlock x:Name="ActivityScopeText" Text="Logitech 입력 대기" Foreground="#555"
                             FontSize="9" HorizontalAlignment="Right"/>
                </DockPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/>
                  </Grid.RowDefinitions>

                  <Border Grid.Row="0" Grid.Column="0" BorderBrush="{StaticResource XpShadow}" BorderThickness="1"
                          Background="White" Margin="0,0,3,3" Padding="5,2">
                    <StackPanel><TextBlock Text="왼쪽 클릭" FontSize="9" Foreground="#555"/><TextBlock x:Name="LeftClicksText" Text="0번" FontSize="14" FontWeight="Bold"/></StackPanel>
                  </Border>
                  <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource XpShadow}" BorderThickness="1"
                          Background="White" Margin="3,0,0,3" Padding="5,2">
                    <StackPanel><TextBlock Text="오른쪽 클릭" FontSize="9" Foreground="#555"/><TextBlock x:Name="RightClicksText" Text="0번" FontSize="14" FontWeight="Bold"/></StackPanel>
                  </Border>
                  <Border Grid.Row="1" Grid.Column="0" BorderBrush="{StaticResource XpShadow}" BorderThickness="1"
                          Background="White" Margin="0,2,3,3" Padding="5,2">
                    <StackPanel><TextBlock Text="휠 클릭" FontSize="9" Foreground="#555"/><TextBlock x:Name="MiddleClicksText" Text="0번" FontSize="14" FontWeight="Bold"/></StackPanel>
                  </Border>
                  <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource XpShadow}" BorderThickness="1"
                          Background="White" Margin="3,2,0,3" Padding="5,2">
                    <StackPanel><TextBlock Text="Actions Ring" FontSize="9" Foreground="#555"/><TextBlock x:Name="ActionRingText" Text="0번" FontSize="14" FontWeight="Bold" Foreground="{StaticResource LogitechMint}"/></StackPanel>
                  </Border>
                  <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="{StaticResource XpShadow}"
                          BorderThickness="1" Background="White" Margin="0,2,0,0" Padding="5,2">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="휠 회전" FontSize="9" Foreground="#555"/><TextBlock x:Name="WheelTurnsText" Text="0회" FontSize="14" FontWeight="Bold"/></StackPanel>
                      <StackPanel Grid.Column="1"><TextBlock Text="휠 이동 거리(추정)" FontSize="9" Foreground="#555" HorizontalAlignment="Right"/><TextBlock x:Name="WheelDistanceText" Text="0.00 m" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/></StackPanel>
                    </Grid>
                  </Border>
                </Grid>
                <TextBlock Text="통계는 이 PC에만 저장되며 매일 자정 초기화됩니다." FontSize="8.5"
                           Foreground="#555" Margin="1,5,0,0"/>
              </StackPanel>
            </TabItem>
          </TabControl>

          <StatusBar Grid.Row="2" Style="{StaticResource XpStatusBar}" Height="26">
            <StatusBarItem HorizontalAlignment="Right">
              <Button Style="{StaticResource XpButton}" MinWidth="90" Height="20" MinHeight="20"
                      Padding="5,0" Click="RefreshBattery_Click">
                <StackPanel Orientation="Horizontal"><Image Source="Assets/Icons/refresh.png" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="배터리 확인" VerticalAlignment="Center"/></StackPanel>
              </Button>
            </StatusBarItem>
          </StatusBar>
        </Grid>
      </Border>
    </Popup>
  </Grid>

  <Window.ContextMenu>
    <ContextMenu Style="{StaticResource XpContextMenu}">
      <MenuItem x:Name="TalkContextMenuItem" Header="맥스에게 말 걸기" Click="Talk_Click"><MenuItem.Icon><Image Source="Assets/Icons/info.png" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
      <Separator/>
      <MenuItem Header="간식으로 축하" Click="Feed_Click"><MenuItem.Icon><Image Source="Assets/Icons/feed.png" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
      <MenuItem Header="하이파이브" Click="Play_Click"><MenuItem.Icon><Image Source="Assets/Icons/play.png" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
      <MenuItem Header="같이 스트레칭" Click="Sleep_Click"><MenuItem.Icon><Image Source="Assets/Icons/sleep.png" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
      <MenuItem Header="잠깐 놀기" Click="ShortPlay_Click"><MenuItem.Icon><Image Source="Assets/Icons/play.png" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
      <Separator/>
      <MenuItem Header="오늘 활동" Click="Status_Click"><MenuItem.Icon><Image Source="Assets/Icons/info.png" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
      <MenuItem Header="MX 배터리 새로 고침" Click="RefreshBattery_Click"><MenuItem.Icon><Image Source="Assets/Icons/refresh.png" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
      <MenuItem Header="이름 바꾸기..." Click="Rename_Click"><MenuItem.Icon><Image Source="Assets/Icons/settings.png" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
