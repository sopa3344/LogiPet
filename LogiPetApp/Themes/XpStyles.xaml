<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Native WPF port of the component anatomy and palette used by XP.css. -->
  <FontFamily x:Key="GalmuriFont">./Assets/Fonts/#Galmuri11</FontFamily>
  <FontFamily x:Key="NeoDunggeunmoFont">./Assets/Fonts/#NeoDunggeunmo</FontFamily>

  <Color x:Key="XpSurfaceColor">#ECE9D8</Color>
  <Color x:Key="XpLightColor">#FFFFFF</Color>
  <Color x:Key="XpShadowColor">#ACA899</Color>
  <Color x:Key="XpDarkColor">#716F64</Color>
  <Color x:Key="XpTitleBlueColor">#0058EE</Color>
  <Color x:Key="XpTitleBlueDarkColor">#003399</Color>
  <Color x:Key="XpTitleBlueLightColor">#3C8CFF</Color>
  <Color x:Key="LogitechMintColor">#2DD48F</Color>
  <Color x:Key="XpTextColor">#222222</Color>

  <SolidColorBrush x:Key="XpSurface" Color="{StaticResource XpSurfaceColor}"/>
  <SolidColorBrush x:Key="XpLight" Color="{StaticResource XpLightColor}"/>
  <SolidColorBrush x:Key="XpShadow" Color="{StaticResource XpShadowColor}"/>
  <SolidColorBrush x:Key="XpDark" Color="{StaticResource XpDarkColor}"/>
  <SolidColorBrush x:Key="XpText" Color="{StaticResource XpTextColor}"/>
  <SolidColorBrush x:Key="LogitechMint" Color="{StaticResource LogitechMintColor}"/>
  <SolidColorBrush x:Key="XpSelection" Color="#316AC5"/>
  <SolidColorBrush x:Key="XpDanger" Color="#E74832"/>
  <SolidColorBrush x:Key="XpWarning" Color="#F2B541"/>

  <LinearGradientBrush x:Key="XpTitleGradient" StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Color="{StaticResource XpTitleBlueDarkColor}" Offset="0"/>
    <GradientStop Color="{StaticResource XpTitleBlueColor}" Offset="0.16"/>
    <GradientStop Color="{StaticResource XpTitleBlueLightColor}" Offset="0.78"/>
    <GradientStop Color="{StaticResource XpTitleBlueColor}" Offset="1"/>
  </LinearGradientBrush>

  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource GalmuriFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource XpText}"/>
  </Style>

  <Style TargetType="Image">
    <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="XpWindowFrame" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource XpSurface}"/>
    <Setter Property="BorderBrush" Value="#0831D9"/>
    <Setter Property="BorderThickness" Value="3"/>
    <Setter Property="CornerRadius" Value="7,7,2,2"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="0" ShadowDepth="3" Direction="315" Color="#70000000"/>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="XpButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource GalmuriFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource XpText}"/>
    <Setter Property="Background" Value="#F5F4EA"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="MinWidth" Value="68"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="#003C74"
                  BorderThickness="1" CornerRadius="3" SnapsToDevicePixels="True">
            <Border x:Name="Inner" BorderBrush="White" BorderThickness="1" CornerRadius="2">
              <ContentPresenter x:Name="Presenter" Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Outer" Property="BorderBrush" Value="#E59700"/>
              <Setter TargetName="Inner" Property="Background" Value="#FFF4CC"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Inner" Property="BorderBrush" Value="{StaticResource XpShadow}"/>
              <Setter TargetName="Presenter" Property="RenderTransform">
                <Setter.Value><TranslateTransform X="1" Y="1"/></Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Outer" Property="BorderBrush" Value="#E59700"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource XpShadow}"/>
              <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource XpShadow}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="XpTitleButton" TargetType="Button">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontFamily" Value="Arial"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Frame" Background="#E95B39" BorderBrush="White" BorderThickness="1"
                  CornerRadius="3" SnapsToDevicePixels="True">
            <Border BorderBrush="#A81E0D" BorderThickness="1" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#FF7656"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#C73A20"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="XpGroupBox" TargetType="GroupBox">
    <Setter Property="FontFamily" Value="{StaticResource GalmuriFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource XpText}"/>
    <Setter Property="Padding" Value="8,10,8,7"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupBox">
          <Grid>
            <Border Margin="0,7,0,0" BorderBrush="{StaticResource XpShadow}" BorderThickness="1" CornerRadius="2">
              <Border BorderBrush="White" BorderThickness="1" CornerRadius="1">
                <ContentPresenter Margin="{TemplateBinding Padding}"/>
              </Border>
            </Border>
            <Border Background="{StaticResource XpSurface}" Padding="4,0" Margin="8,0,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
              <ContentPresenter ContentSource="Header"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="XpProgressBar" TargetType="ProgressBar">
    <Setter Property="Height" Value="14"/>
    <Setter Property="Background" Value="White"/>
    <Setter Property="Foreground" Value="{StaticResource LogitechMint}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border BorderBrush="{StaticResource XpDark}" BorderThickness="1" Background="White" Padding="2">
            <Grid x:Name="PART_Track" ClipToBounds="True">
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#8FF0C6" Offset="0"/>
                    <GradientStop Color="{StaticResource LogitechMintColor}" Offset="0.45"/>
                    <GradientStop Color="#159A63" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="XpTabControl" TargetType="TabControl">
    <Setter Property="FontFamily" Value="{StaticResource GalmuriFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Background" Value="{StaticResource XpSurface}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <TabPanel Grid.Row="0" IsItemsHost="True" Panel.ZIndex="1"/>
            <Border Grid.Row="1" BorderBrush="{StaticResource XpDark}" BorderThickness="1" Background="{TemplateBinding Background}" Padding="8">
              <ContentPresenter ContentSource="SelectedContent"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="FontFamily" Value="{StaticResource GalmuriFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="TabBorder" Background="#D4D0C8" BorderBrush="{StaticResource XpDark}"
                  BorderThickness="1" Padding="{TemplateBinding Padding}" Margin="0,2,1,-1">
            <ContentPresenter ContentSource="Header"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource XpSurface}"/>
              <Setter TargetName="TabBorder" Property="Margin" Value="0,0,1,-1"/>
              <Setter TargetName="TabBorder" Property="Padding" Value="10,4,10,4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="XpStatusBar" TargetType="StatusBar">
    <Setter Property="Background" Value="{StaticResource XpSurface}"/>
    <Setter Property="Padding" Value="1"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="StatusBar">
          <Border BorderBrush="{StaticResource XpShadow}" BorderThickness="1,1,0,0" Background="{TemplateBinding Background}">
            <ItemsPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="XpContextMenu" TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="{StaticResource GalmuriFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="{StaticResource XpDark}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="HasDropShadow" Value="True"/>
  </Style>

  <Style x:Key="XpMenuButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource GalmuriFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Height" Value="27"/>
    <Setter Property="MinWidth" Value="132"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="5,2"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="MenuRow" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="MenuRow" Property="Background" Value="{StaticResource XpSelection}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="MenuRow" Property="Background" Value="#1C4F96"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
